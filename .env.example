# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ds_copilot
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5-5
API_PORT=3001
# Address of the API used by the web app's server-side proxy (default: http://localhost:3001).
# Next.js reads env files from apps/web, so put overrides in apps/web/.env.local.
API_URL=http://localhost:3001
