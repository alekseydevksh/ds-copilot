{
  "name": "ds-copilot",
  "packageManager": "yarn@4.18.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "yarn workspace @ds-copilot/db db:generate",
    "db:migrate": "yarn workspace @ds-copilot/db db:migrate",
    "dev:api": "yarn workspace @ds-copilot/api dev",
    "dev:web": "yarn workspace @ds-copilot/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "nx": "24.0.3",
    "prettier": "^3.9.10",
    "typescript": "6",
    "typescript-eslint": "^8.72.1"
  }
}
